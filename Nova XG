.join-box::before{content:'NOVA XG';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-family:'Orbitron',monospace;font-size:8rem;font-weight:900;color:rgba(123,47,255,.04);white-space:nowrap;pointer-events:none;letter-spacing:.1em}
.j-icon{width:58px;height:58px;object-fit:contain;margin:0 auto 20px;filter:drop-shadow(0 0 18px rgba(123,47,255,.8));animation:logoP 3s ease-in-out infinite}
@keyframes logoP{0%,100%{filter:drop-shadow(0 0 18px rgba(123,47,255,.5))}50%{filter:drop-shadow(0 0 40px rgba(168,85,247,.9))}}
.j-title{font-family:'Orbitron',monospace;font-size:clamp(1.8rem,4vw,3rem);font-weight:900;background:linear-gradient(135deg,#fff,var(--p3),var(--sv));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;line-height:1;margin-bottom:16px}
.j-sub{font-size:.97rem;color:var(--sv3);line-height:1.8;margin-bottom:36px;max-width:520px;margin-left:auto;margin-right:auto}
.j-sub b{color:var(--p3);font-weight:600}
.j-reqs{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;max-width:600px;margin:0 auto 36px}
.j-req{padding:14px;border:1px solid var(--border);background:rgba(42,0,64,.2);clip-path:polygon(6px 0,100% 0,calc(100% - 6px) 100%,0 100%)}
.j-req-v{font-family:'Orbitron',monospace;font-size:1rem;font-weight:700;color:var(--p2);display:block}
.j-req-l{font-size:.68rem;letter-spacing:.12em;color:var(--sv3);text-transform:uppercase}

/* ═══════════════ ANIMATIONS ═══════════════ */
@keyframes fadeD{from{opacity:0;transform:translateY(-16px)}to{opacity:1;transform:translateY(0)}}
@keyframes fadeU{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
.reveal{opacity:0;transform:translateY(24px);transition:opacity .7s ease,transform .7s ease}
.reveal.vis{opacity:1;transform:translateY(0)}

/* ═══════════════ FOOTER ═══════════════ */
footer{border-top:1px solid var(--border);padding:28px 32px;display:flex;justify-content:space-between;align-items:center;background:var(--bg2);flex-wrap:wrap;gap:14px}
.f-logo{height:38px;width:auto;object-fit:contain;filter:drop-shadow(0 0 5px rgba(123,47,255,.35))}
