<!DOCTYPE html>
<html lang="en" data-lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>NOVA XG — Gaming Club</title>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700;900&family=Rajdhani:wght@300;400;500;600;700&family=Share+Tech+Mono&family=Tajawal:wght@300;400;500;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#07000c;--bg2:#0e0016;--bg3:#170028;
  --p1:#7b2fff;--p2:#a855f7;--p3:#c084fc;--p4:#e9d5ff;
  --sv:#c0c0c0;--sv2:#e8e8e8;--sv3:#888;--sv4:#3a3a3a;
  --border:rgba(123,47,255,.18);--glow:rgba(123,47,255,.5);
  --mw:340px;--nh:68px;
}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--sv2);font-family:'Rajdhani',sans-serif;overflow-x:hidden;cursor:none}
[data-lang=ar]{direction:rtl;font-family:'Tajawal',sans-serif}
a{text-decoration:none;color:inherit}
::-webkit-scrollbar{width:3px}
::-webkit-scrollbar-track{background:var(--bg2)}
::-webkit-scrollbar-thumb{background:var(--p1);border-radius:2px}

/* CURSOR */
#cur{position:fixed;width:10px;height:10px;background:var(--p1);border-radius:50%;pointer-events:none;z-index:9999;transform:translate(-50%,-50%);box-shadow:0 0 12px var(--p1),0 0 25px var(--p2);transition:width .2s,height .2s}
#cur2{position:fixed;width:30px;height:30px;border:1px solid rgba(168,85,247,.4);border-radius:50%;pointer-events:none;z-index:9998;transform:translate(-50%,-50%);transition:width .25s,height .25s}
body.hov #cur{width:16px;height:16px}
body.hov #cur2{width:44px;height:44px}

/* LOADER */
#loader{position:fixed;inset:0;background:var(--bg);display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:9990;transition:opacity .8s,visibility .8s}
#loader.hide{opacity:0;visibility:hidden}
.ld-logo{width:100px;height:100px;object-fit:contain;animation:ldSpin 3s linear infinite,ldGlow 2s ease-in-out infinite}
@keyframes ldSpin{to{transform:rotate(360deg)}}
@keyframes ldGlow{0%,100%{filter:drop-shadow(0 0 18px rgba(123,47,255,.6))}50%{filter:drop-shadow(0 0 45px rgba(168,85,247,1))}}
.ld-bar-wrap{margin-top:28px;width:180px;height:2px;background:rgba(123,47,255,.15);border-radius:2px;overflow:hidden}
.ld-bar{height:100%;width:0;background:linear-gradient(90deg,var(--p1),var(--p3));box-shadow:0 0 10px var(--glow);transition:width .04s linear}
.ld-txt{margin-top:16px;font-family:'Share Tech Mono',monospace;font-size:.62rem;letter-spacing:.5em;color:var(--p1);animation:blink 1.4s ease-in-out infinite}
@keyframes blink{0%,100%{opacity:.3}50%{opacity:1}}

/* SCANLINE */
.scan{position:fixed;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,rgba(123,47,255,.2),transparent);animation:scanAnim 12s linear infinite;pointer-events:none;z-index:8000}
@keyframes scanAnim{from{top:-2px}to{top:100vh}}

/* NAV */
nav{position:fixed;top:0;left:0;right:0;height:var(--nh);z-index:5000;display:flex;align-items:center;justify-content:space-between;padding:0 28px;background:linear-gradient(180deg,rgba(7,0,12,.97),rgba(7,0,12,.7));backdrop-filter:blur(18px);border-bottom:1px solid var(--border)}
.nav-logo{height:44px;width:auto;object-fit:contain;filter:drop-shadow(0 0 8px rgba(123,47,255,.45));transition:filter .3s;cursor:none}
.nav-logo:hover{filter:drop-shadow(0 0 20px rgba(168,85,247,.9))}
.ham{width:42px;height:42px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;cursor:none;border:1px solid var(--border);background:rgba(123,47,255,.07);clip-path:polygon(6px 0,100% 0,calc(100% - 6px) 100%,0 100%);transition:border-color .3s,background .3s}
.ham:hover{border-color:var(--p1);background:rgba(123,47,255,.18)}
.ham span{display:block;width:20px;height:1.5px;background:var(--sv2);transition:transform .35s,opacity .35s,width .35s;transform-origin:center}
.ham.open span:nth-child(1){transform:translateY(6.5px) rotate(45deg)}
.ham.open span:nth-child(2){opacity:0;width:0}
.ham.open span:nth-child(3){transform:translateY(-6.5px) rotate(-45deg)}

/* OVERLAY + PANEL */
.ov{position:fixed;inset:0;z-index:4400;background:rgba(0,0,0,.6);backdrop-filter:blur(4px);opacity:0;visibility:hidden;transition:opacity .35s,visibility .35s}
.ov.open{opacity:1;visibility:visible}
.panel{position:fixed;top:0;right:0;width:var(--mw);height:100vh;background:linear-gradient(160deg,rgba(14,0,22,.99),rgba(7,0,12,.99));border-left:1px solid var(--border);z-index:4600;transform:translateX(100%);transition:transform .35s cubic-bezier(.4,0,.2,1);overflow-y:auto;display:flex;flex-direction:column}
.panel.open{transform:translateX(0)}
[data-lang=ar] .panel{right:auto;left:0;border-left:none;border-right:1px solid var(--border);transform:translateX(-100%)}
[data-lang=ar] .panel.open{transform:translateX(0)}

.ph{padding:22px 26px 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:12px}
.ph img{width:38px;height:38px;object-fit:contain;filter:drop-shadow(0 0 7px var(--glow))}
.ph-cn{font-family:'Orbitron',monospace;font-size:.9rem;font-weight:900;background:linear-gradient(135deg,var(--sv2),var(--p3));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.ph-cs{font-family:'Share Tech Mono',monospace;font-size:.58rem;letter-spacing:.2em;color:var(--p2);margin-top:2px}

.pb{flex:1;padding:10px 0}
.ps-title{font-family:'Share Tech Mono',monospace;font-size:.58rem;letter-spacing:.35em;color:var(--sv4);text-transform:uppercase;padding:10px 26px 5px}
.mi{display:flex;align-items:center;justify-content:space-between;padding:12px 26px;font-size:.95rem;font-weight:600;color:var(--sv3);cursor:none;transition:background .3s,color .3s,border-color .3s;border-left:2px solid transparent;position:relative}
[data-lang=ar] .mi{border-left:none;border-right:2px solid transparent}
.mi:hover{background:rgba(123,47,255,.1);color:var(--sv2);border-left-color:var(--p1)}
[data-lang=ar] .mi:hover{border-left-color:transparent;border-right-color:var(--p1)}
.mi-l{display:flex;align-items:center;gap:11px}
.mi-ic{width:26px;height:26px;object-fit:contain;filter:brightness(.55);transition:filter .3s;flex-shrink:0}
.mi:hover .mi-ic{filter:brightness(1) drop-shadow(0 0 5px var(--glow))}
.mi-arr{font-size:.7rem;color:var(--sv4);transition:transform .3s,color .3s}
.mi:hover .mi-arr{transform:translateX(4px);color:var(--p2)}
[data-lang=ar] .mi:hover .mi-arr{transform:translateX(-4px)}
.mi.hs .mi-arr{transition:transform .3s,color .3s}
.mi.hs.op .mi-arr{transform:rotate(90deg);color:var(--p2)}
[data-lang=ar] .mi.hs.op .mi-arr{transform:rotate(-90deg)}

.sm{overflow:hidden;max-height:0;transition:max-height .4s cubic-bezier(.4,0,.2,1)}
.sm.op{max-height:500px}
.smi{display:flex;align-items:center;gap:9px;padding:9px 26px 9px 50px;font-size:.88rem;color:var(--sv4);cursor:none;transition:color .3s,background .3s;border-left:2px solid transparent}
[data-lang=ar] .smi{padding:9px 50px 9px 26px;border-left:none;border-right:2px solid transparent}
.smi:hover{color:var(--p3);background:rgba(123,47,255,.06);border-left-color:rgba(123,47,255,.35)}
[data-lang=ar] .smi:hover{border-left-color:transparent;border-right-color:rgba(123,47,255,.35)}
.sdot{width:4px;height:4px;border-radius:50%;background:var(--sv4);flex-shrink:0;transition:background .3s}
.smi:hover .sdot{background:var(--p2)}
.badge{font-family:'Share Tech Mono',monospace;font-size:.56rem;letter-spacing:.08em;background:var(--p1);color:#fff;padding:2px 7px;clip-path:polygon(4px 0,100% 0,calc(100% - 4px) 100%,0 100%)}
.badge-new{background:linear-gradient(135deg,#ff6b2f,#ff4500)}

.pf{padding:18px 26px;border-top:1px solid var(--border)}
.pf-soc{display:flex;gap:10px}
.pf-s{font-family:'Share Tech Mono',monospace;font-size:.62rem;letter-spacing:.12em;color:var(--sv4);text-transform:uppercase;border:1px solid var(--sv4);padding:6px 13px;transition:color .3s,border-color .3s;clip-path:polygon(5px 0,100% 0,calc(100% - 5px) 100%,0 100%)}
.pf-s:hover{color:var(--p3);border-color:var(--p2)}

/* PAGE SYSTEM */
.page{display:none;min-height:100vh}
.page.active{display:block}

/* ═══════════════ HERO ═══════════════ */
#page-home{position:relative;min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:calc(var(--nh)+40px) 20px 60px;overflow:hidden;text-align:center}

/* Particle canvas */
#pcanvas{position:absolute;inset:0;z-index:0;pointer-events:none}

/* Animated grid */
.h-grid{position:absolute;inset:0;z-index:0;pointer-events:none;background-image:linear-gradient(rgba(123,47,255,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(123,47,255,.05) 1px,transparent 1px);background-size:60px 60px;animation:gridD 20s linear infinite}
@keyframes gridD{to{background-position:60px 60px}}

/* Neon radial glow */
.h-rad{position:absolute;top:40%;left:50%;transform:translate(-50%,-50%);width:800px;height:800px;background:radial-gradient(ellipse,rgba(123,47,255,.14) 0%,transparent 65%);pointer-events:none;z-index:0}

/* Smoke layers */
.smoke{position:absolute;border-radius:50%;filter:blur(80px);pointer-events:none;z-index:0;animation:smokeDrift linear infinite}
.smoke1{width:500px;height:500px;background:rgba(123,47,255,.06);top:10%;left:-10%;animation-duration:18s}
.smoke2{width:400px;height:400px;background:rgba(168,85,247,.05);bottom:5%;right:-5%;animation-duration:22s;animation-delay:-8s}
.smoke3{width:300px;height:300px;background:rgba(192,100,252,.04);top:50%;left:60%;animation-duration:15s;animation-delay:-4s}
@keyframes smokeDrift{0%{transform:translate(0,0) scale(1)}33%{transform:translate(30px,-20px) scale(1.08)}66%{transform:translate(-20px,15px) scale(.95)}100%{transform:translate(0,0) scale(1)}}

.h-content{position:relative;z-index:1}

/* Badge */
.h-badge{display:inline-flex;align-items:center;gap:8px;font-family:'Share Tech Mono',monospace;font-size:.65rem;letter-spacing:.4em;color:var(--p3);border:1px solid rgba(168,85,247,.3);padding:6px 20px;margin-bottom:28px;animation:fadeD .7s ease both}
.h-dot{width:5px;height:5px;border-radius:50%;background:var(--p1);box-shadow:0 0 8px var(--p1);animation:dotP 1.5s ease-in-out infinite}
@keyframes dotP{0%,100%{opacity:.3}50%{opacity:1}}

/* Logo */
.h-logo{width:clamp(180px,38vw,400px);height:auto;object-fit:contain;margin:0 auto 20px;animation:fadeD .85s .1s ease both,logoP 5s ease-in-out infinite}
@keyframes logoP{0%,100%{filter:drop-shadow(0 0 28px rgba(123,47,255,.55))}50%{filter:drop-shadow(0 0 55px rgba(168,85,247,.95)) drop-shadow(0 0 90px rgba(123,47,255,.4))}}

/* Taglines */
.h-lines{margin-bottom:32px;animation:fadeD 1s .2s ease both}
.h-line{font-family:'Orbitron',monospace;font-size:clamp(.75rem,2vw,1rem);font-weight:400;letter-spacing:.3em;color:var(--sv3);opacity:0;transform:translateY(10px);transition:opacity .5s,transform .5s}
.h-line.vis{opacity:1;transform:translateY(0)}
.h-line.hl{color:var(--p3);font-size:clamp(.9rem,2.5vw,1.25rem);font-weight:600}

/* Divider */
.h-div{width:140px;height:1px;background:linear-gradient(90deg,transparent,var(--p1),transparent);margin:0 auto 28px;animation:fadeD 1s .3s ease both}

/* Buttons */
.h-btns{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;animation:fadeD 1s .4s ease both}
.btn{font-family:'Orbitron',monospace;font-size:.7rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;padding:13px 32px;cursor:none;clip-path:polygon(9px 0,100% 0,calc(100% - 9px) 100%,0 100%);transition:transform .2s,box-shadow .3s;display:inline-flex;align-items:center;gap:8px}
.btn:hover{transform:translateY(-2px)}
.btn-p{background:linear-gradient(135deg,var(--p1),var(--p2));color:#fff;border:none}
.btn-p:hover{box-shadow:0 0 28px rgba(123,47,255,.7),0 0 55px rgba(123,47,255,.3)}
.btn-s{background:transparent;color:var(--sv);border:1px solid rgba(192,192,192,.3)}
.btn-s:hover{border-color:var(--sv2);color:#fff;box-shadow:0 0 18px rgba(192,192,192,.12)}
.btn-o{background:transparent;color:var(--p3);border:1px solid rgba(168,85,247,.35)}
.btn-o:hover{border-color:var(--p2);box-shadow:0 0 20px rgba(123,47,255,.3)}

/* Scroll indicator */
.h-scroll{position:absolute;bottom:28px;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:6px;animation:fadeD 1.2s .8s ease both;z-index:1}
.h-scroll span{font-family:'Share Tech Mono',monospace;font-size:.58rem;letter-spacing:.3em;color:var(--sv4)}
.scroll-line{width:1px;height:36px;background:linear-gradient(180deg,var(--p1),transparent);animation:scrollPulse 2s ease-in-out infinite}
@keyframes scrollPulse{0%,100%{opacity:.3}50%{opacity:1}}

/* Stats strip */
.h-stats{display:flex;justify-content:center;width:100%;max-width:760px;margin:40px auto 0;animation:fadeU 1s .5s ease both}
.stat{flex:1;text-align:center;padding:18px 12px;border:1px solid var(--border);border-right:none;background:rgba(20,0,35,.35);backdrop-filter:blur(10px);position:relative;overflow:hidden}
.stat:last-child{border-right:1px solid var(--border)}
.stat::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--p1),transparent);transform:scaleX(0);transition:transform .4s}
.stat:hover::before{transform:scaleX(1)}
.stat-n{font-family:'Orbitron',monospace;font-size:1.4rem;font-weight:900;background:linear-gradient(135deg,var(--p2),var(--sv));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.stat-l{font-size:.68rem;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--sv3);margin-top:3px}

/* ═══════════════ GAME PAGE ═══════════════ */
.game-page{padding:calc(var(--nh) + 50px) 32px 80px;max-width:1200px;margin:0 auto}
.gp-hero{display:grid;grid-template-columns:1fr 2fr;gap:48px;align-items:center;margin-bottom:72px;padding-bottom:48px;border-bottom:1px solid var(--border)}
.gp-logo-wrap{display:flex;align-items:center;justify-content:center}
.gp-logo{width:160px;height:160px;border-radius:50%;object-fit:contain;background:rgba(42,0,64,.5);border:2px solid var(--border);box-shadow:0 0 40px rgba(123,47,255,.3);padding:20px}
.gp-title{font-family:'Orbitron',monospace;font-size:clamp(1.6rem,4vw,2.8rem);font-weight:900;color:var(--sv2);margin-bottom:8px}
.gp-title span{background:linear-gradient(135deg,var(--p1),var(--p3));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.gp-sub{font-size:1rem;color:var(--sv3);letter-spacing:.1em;margin-bottom:20px}
.gp-tags{display:flex;flex-wrap:wrap;gap:8px}
.gp-tag{font-family:'Share Tech Mono',monospace;font-size:.65rem;letter-spacing:.1em;color:var(--p3);border:1px solid rgba(168,85,247,.25);padding:4px 12px;background:rgba(42,0,64,.4);clip-path:polygon(5px 0,100% 0,calc(100% - 5px) 100%,0 100%)}

/* Game sections */
.gs-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:24px;margin-bottom:32px}
.gs-card{background:linear-gradient(135deg,rgba(42,0,64,.4),rgba(14,0,22,.8));border:1px solid var(--border);padding:28px 24px;position:relative;overflow:hidden;transition:transform .3s,border-color .3s}
.gs-card::after{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--p1),transparent);transform:scaleX(0);transition:transform .4s;transform-origin:left}
.gs-card:hover{transform:translateY(-4px);border-color:rgba(123,47,255,.4)}
.gs-card:hover::after{transform:scaleX(1)}
.gs-card-title{font-family:'Orbitron',monospace;font-size:1rem;font-weight:700;color:var(--sv2);margin-bottom:16px;display:flex;align-items:center;gap:10px}
.gs-card-title img{width:22px;height:22px;object-fit:contain;filter:drop-shadow(0 0 5px var(--glow))}

/* Player row */
.p-row{display:flex;align-items:center;gap:14px;padding:10px 0;border-bottom:1px solid rgba(123,47,255,.08)}
.p-row:last-child{border-bottom:none}
.p-av{width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:'Orbitron',monospace;font-size:.9rem;font-weight:700;color:#fff;flex-shrink:0;border:1px solid rgba(168,85,247,.3)}
.p-name{font-family:'Orbitron',monospace;font-size:.82rem;font-weight:600;color:var(--sv2)}
.p-role{font-size:.72rem;color:var(--sv3);letter-spacing:.08em}
.p-badge{margin-left:auto;font-family:'Share Tech Mono',monospace;font-size:.6rem;letter-spacing:.1em;color:var(--p3);border:1px solid rgba(168,85,247,.25);padding:2px 8px}

/* Stats grid */
.stats-mini{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
.stat-mini{padding:14px;background:rgba(7,0,12,.5);border:1px solid rgba(123,47,255,.12);text-align:center}
.stat-mini-n{font-family:'Orbitron',monospace;font-size:1.3rem;font-weight:900;color:var(--p2)}
.stat-mini-l{font-size:.65rem;color:var(--sv3);letter-spacing:.12em;text-transform:uppercase;margin-top:2px}

/* Tournament rows */
.t-row{display:flex;align-items:center;justify-content:space-between;padding:12px 0;border-bottom:1px solid rgba(123,47,255,.08)}
.t-row:last-child{border-bottom:none}
.t-name{font-size:.9rem;color:var(--sv2)}
.t-res{font-family:'Orbitron',monospace;font-size:.78rem;color:var(--p2)}
.t-place{font-size:.7rem;color:var(--sv3)}

/* Videos placeholder */
.vid-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
.vid-card{aspect-ratio:16/9;background:rgba(42,0,64,.3);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;cursor:none;transition:border-color .3s}
.vid-card:hover{border-color:var(--p2)}
.vid-play{width:48px;height:48px;border-radius:50%;background:rgba(123,47,255,.8);display:flex;align-items:center;justify-content:center;font-size:1.2rem;transition:transform .3s,box-shadow .3s}
.vid-card:hover .vid-play{transform:scale(1.1);box-shadow:0 0 20px rgba(123,47,255,.6)}
.vid-label{position:absolute;bottom:10px;left:12px;font-family:'Share Tech Mono',monospace;font-size:.62rem;letter-spacing:.1em;color:var(--sv3)}

/* Full-width sections */
.gs-full{background:linear-gradient(135deg,rgba(42,0,64,.4),rgba(14,0,22,.8));border:1px solid var(--border);padding:28px 24px;margin-bottom:24px;position:relative;overflow:hidden}
.gs-full::after{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--p1),transparent);transform:scaleX(0);transition:transform .4s;transform-origin:left}
.gs-full:hover::after{transform:scaleX(1)}

/* Best players */
.bp-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.bp-card{background:rgba(7,0,12,.5);border:1px solid rgba(123,47,255,.12);padding:20px 16px;text-align:center;transition:border-color .3s,transform .3s}
.bp-card:hover{border-color:rgba(123,47,255,.4);transform:translateY(-4px)}
.bp-av{width:56px;height:56px;border-radius:50%;margin:0 auto 10px;display:flex;align-items:center;justify-content:center;font-family:'Orbitron',monospace;font-size:1.1rem;font-weight:700;color:#fff;border:2px solid rgba(168,85,247,.3)}
.bp-name{font-family:'Orbitron',monospace;font-size:.82rem;font-weight:700;color:var(--sv2);margin-bottom:4px}
.bp-role{font-size:.72rem;color:var(--sv3)}
.bp-kda{margin-top:10px;font-family:'Share Tech Mono',monospace;font-size:.7rem;color:var(--p2)}

/* ═══════════════ NEWS ═══════════════ */
.news-page{padding:calc(var(--nh) + 50px) 32px 80px;max-width:1000px;margin:0 auto}
.news-header{margin-bottom:48px}
.news-title{font-family:'Orbitron',monospace;font-size:clamp(1.8rem,4vw,2.8rem);font-weight:900;background:linear-gradient(135deg,var(--sv2),var(--p3));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin-bottom:8px}
.news-sub{font-size:.9rem;color:var(--sv3);letter-spacing:.1em}
.news-filters{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:32px}
.nf-btn{font-family:'Share Tech Mono',monospace;font-size:.65rem;letter-spacing:.15em;text-transform:uppercase;padding:7px 18px;border:1px solid var(--border);background:transparent;color:var(--sv3);cursor:none;transition:all .3s;clip-path:polygon(5px 0,100% 0,calc(100% - 5px) 100%,0 100%)}
.nf-btn:hover,.nf-btn.active{border-color:var(--p1);color:var(--p3);background:rgba(123,47,255,.1)}
.news-grid{display:flex;flex-direction:column;gap:16px}
