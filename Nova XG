.aring{position:absolute;border-radius:50%;border:1px solid;top:50%;left:50%;transform:translate(-50%,-50%);animation:spinR linear infinite}
.aring:nth-child(1){width:90%;height:90%;border-color:rgba(123,47,255,.2);animation-duration:20s}
.aring:nth-child(2){width:68%;height:68%;border-color:rgba(192,192,192,.12);animation-duration:14s;animation-direction:reverse}
.aring:nth-child(3){width:46%;height:46%;border-color:rgba(168,85,247,.3);animation-duration:9s}
@keyframes spinR{to{transform:translate(-50%,-50%) rotate(360deg)}}
.arc{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:28%;aspect-ratio:1;border-radius:50%;overflow:hidden;border:2px solid rgba(168,85,247,.4);box-shadow:0 0 28px rgba(123,47,255,.5)}
