.atxt h3 span{background:linear-gradient(135deg,var(--p1),var(--sv));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.atxt p{color:var(--sv3);line-height:1.85;font-size:.97rem;margin-bottom:12px}
.atxt p b{color:var(--p3);font-weight:600}
.atags{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px}
.atag{font-family:'Share Tech Mono',monospace;font-size:.67rem;letter-spacing:.1em;color:var(--p3);border:1px solid rgba(168,85,247,.22);padding:4px 12px;background:rgba(42,0,64,.35);clip-path:polygon(5px 0,100% 0,calc(100% - 5px) 100%,0 100%)}

/* Roster cards */
.roster-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-bottom:48px}
.rcard{background:linear-gradient(135deg,rgba(42,0,64,.4),rgba(14,0,22,.8));border:1px solid var(--border);padding:28px 20px;text-align:center;position:relative;overflow:hidden;transition:transform .3s,border-color .3s;clip-path:polygon(0 0,calc(100% - 14px) 0,100% 14px,100% 100%,14px 100%,0 calc(100% - 14px))}
